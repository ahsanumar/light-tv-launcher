<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/gtv_round_icon"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/gtv_round_icon_background"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- INVISIBLE (not GONE) so showing the label on focus doesn't shift the row -->
    <TextView
        android:id="@+id/gtv_round_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/gtv_text_primary"
        android:textSize="13sp"
        android:visibility="invisible" />
</LinearLayout>
