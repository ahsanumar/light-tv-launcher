<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GtvTopBarIconButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/gtv_pill_button</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/gtv_on_pill_tint</item>
    </style>

    <style name="GtvTopBarTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="GtvSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">36dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/gtv_text_secondary</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
